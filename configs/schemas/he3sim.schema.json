{
  "$defs": {
    "ADCConfig": {
      "additionalProperties": false,
      "description": "Uniform ADC quantization configuration.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "bits": {
          "$ref": "#/$defs/ParameterValue_Annotated_int__Strict_strict_True___"
        },
        "input_min_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "input_max_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "offset_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "bits",
        "input_min_V",
        "input_max_V",
        "offset_V"
      ],
      "title": "ADCConfig",
      "type": "object"
    },
    "AmplitudeCalibrationConfig": {
      "additionalProperties": false,
      "description": "Placeholder values for the future energy-to-peak calibration.",
      "properties": {
        "gain_V_per_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "offset_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "spread_std_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "polarity": {
          "$ref": "#/$defs/ParameterValue_int_"
        }
      },
      "required": [
        "gain_V_per_keV",
        "offset_V",
        "spread_std_V",
        "polarity"
      ],
      "title": "AmplitudeCalibrationConfig",
      "type": "object"
    },
    "BaselineConfig": {
      "additionalProperties": false,
      "description": "Constant baseline configuration.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "offset_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "offset_V"
      ],
      "title": "BaselineConfig",
      "type": "object"
    },
    "DatasetConfig": {
      "additionalProperties": false,
      "description": "Phase 3 bounded continuous-region and HDF5 storage controls.",
      "properties": {
        "continuous_duration_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "max_windows": {
          "$ref": "#/$defs/ParameterValue_Annotated_int__Strict_strict_True___"
        },
        "compression": {
          "default": "gzip",
          "title": "Compression",
          "type": "string"
        },
        "compression_level": {
          "default": 4,
          "maximum": 9,
          "minimum": 0,
          "title": "Compression Level",
          "type": "integer"
        }
      },
      "required": [
        "continuous_duration_s",
        "max_windows"
      ],
      "title": "DatasetConfig",
      "type": "object"
    },
    "DeadTimeConfig": {
      "additionalProperties": false,
      "description": "Observation-layer dead-time configuration.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DeadTimeMode",
          "default": "none"
        },
        "duration_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "duration_s"
      ],
      "title": "DeadTimeConfig",
      "type": "object"
    },
    "DeadTimeMode": {
      "description": "Supported future dead-time modes.",
      "enum": [
        "none",
        "nonparalyzable",
        "paralyzable"
      ],
      "title": "DeadTimeMode",
      "type": "string"
    },
    "EnergySpectrumConfig": {
      "additionalProperties": false,
      "description": "Parameters for the Phase 1 He-3 deposited-energy mixture model.",
      "properties": {
        "provider": {
          "default": "parametric_he3",
          "title": "Provider",
          "type": "string"
        },
        "full_energy_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "full_energy_sigma_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "full_energy_fraction": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "proton_wall_fraction": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "proton_wall_min_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "proton_wall_max_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "proton_wall_alpha": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "proton_wall_beta": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "triton_wall_fraction": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "triton_wall_min_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "triton_wall_max_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "triton_wall_alpha": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "triton_wall_beta": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "double_wall_fraction": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "double_wall_min_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "double_wall_max_keV": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "double_wall_alpha": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "double_wall_beta": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "full_energy_keV",
        "full_energy_sigma_keV",
        "full_energy_fraction",
        "proton_wall_fraction",
        "proton_wall_min_keV",
        "proton_wall_max_keV",
        "proton_wall_alpha",
        "proton_wall_beta",
        "triton_wall_fraction",
        "triton_wall_min_keV",
        "triton_wall_max_keV",
        "triton_wall_alpha",
        "triton_wall_beta",
        "double_wall_fraction",
        "double_wall_min_keV",
        "double_wall_max_keV",
        "double_wall_alpha",
        "double_wall_beta"
      ],
      "title": "EnergySpectrumConfig",
      "type": "object"
    },
    "NoiseConfig": {
      "additionalProperties": false,
      "description": "White-noise and optional stationary AR(1) drift configuration.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "white_noise_rms_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "low_frequency_drift_enabled": {
          "default": false,
          "title": "Low Frequency Drift Enabled",
          "type": "boolean"
        },
        "low_frequency_drift_rms_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "low_frequency_drift_correlation_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "white_noise_rms_V",
        "low_frequency_drift_rms_V",
        "low_frequency_drift_correlation_s"
      ],
      "title": "NoiseConfig",
      "type": "object"
    },
    "ObservationMode": {
      "description": "Method used to define the virtual observation horizon.",
      "enum": [
        "fixed_duration",
        "target_event_count"
      ],
      "title": "ObservationMode",
      "type": "string"
    },
    "ObservationWindowConfig": {
      "additionalProperties": false,
      "description": "Configuration for a fixed duration or a target event count.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ObservationMode"
        },
        "duration_s": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterValue_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_event_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterValue_int_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_duration_s": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterValue_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_duration_s": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterValue_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "title": "ObservationWindowConfig",
      "type": "object"
    },
    "ParameterStatus": {
      "description": "Evidence status attached to configurable numerical parameters.",
      "enum": [
        "synthetic_demo",
        "provisional",
        "validated"
      ],
      "title": "ParameterStatus",
      "type": "string"
    },
    "ParameterValue_Annotated_int__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "$ref": "#/$defs/ParameterStatus"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
