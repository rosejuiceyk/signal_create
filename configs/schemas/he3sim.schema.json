  "required": [
    "metadata",
    "simulation",
    "observation",
    "spectrum",
    "amplitude",
    "pulse_shape",
    "waveform",
    "baseline",
    "noise",
    "adc",
    "trigger",
    "dead_time",
    "dataset"
  ],
  "title": "He3SimConfig",
  "type": "object"
}
