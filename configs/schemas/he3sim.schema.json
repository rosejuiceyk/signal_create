  "additionalProperties": false,
  "description": "Top-level configuration contract used through Phase 3.",
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RunMetadataConfig"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationDomainConfig"
    },
    "observation": {
      "$ref": "#/$defs/ObservationWindowConfig"
    },
    "spectrum": {
      "$ref": "#/$defs/EnergySpectrumConfig"
    },
    "amplitude": {
      "$ref": "#/$defs/AmplitudeCalibrationConfig"
    },
    "pulse_shape": {
      "$ref": "#/$defs/PulseShapeConfig"
    },
    "waveform": {
      "$ref": "#/$defs/WaveformSynthesisConfig"
    },
    "baseline": {
      "$ref": "#/$defs/BaselineConfig"
    },
    "noise": {
      "$ref": "#/$defs/NoiseConfig"
    },
    "adc": {
      "$ref": "#/$defs/ADCConfig"
    },
    "trigger": {
      "$ref": "#/$defs/TriggerConfig"
    },
    "dead_time": {
      "$ref": "#/$defs/DeadTimeConfig"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetConfig"
    }
