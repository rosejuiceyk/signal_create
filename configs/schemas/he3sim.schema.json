    "PulseShapeConfig": {
      "additionalProperties": false,
      "description": "Time constants for the peak-normalized double exponential.",
      "properties": {
        "tau_r_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "tau_d_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "tau_r_s",
        "tau_d_s"
      ],
      "title": "PulseShapeConfig",
      "type": "object"
    },
    "RunMetadataConfig": {
      "additionalProperties": false,
      "description": "Run identity and reproducibility inputs.",
      "properties": {
        "run_name": {
          "minLength": 1,
          "title": "Run Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "seed": {
          "$ref": "#/$defs/ParameterValue_Annotated_int__Strict_strict_True___"
        }
      },
      "required": [
        "run_name",
        "seed"
      ],
      "title": "RunMetadataConfig",
      "type": "object"
    },
    "SimulationDomainConfig": {
      "additionalProperties": false,
      "description": "Supported true-rate and sampling-rate operating inputs.",
      "properties": {
        "true_rate_cps": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "sample_rate_hz": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "true_rate_cps",
        "sample_rate_hz"
      ],
      "title": "SimulationDomainConfig",
      "type": "object"
    },
    "TriggerConfig": {
      "additionalProperties": false,
      "description": "Threshold trigger and fixed event-window configuration.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "polarity": {
          "$ref": "#/$defs/ParameterValue_int_"
        },
        "threshold_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "hysteresis_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "min_hold_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "pre_trigger_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "post_trigger_s": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "polarity",
        "threshold_V",
        "hysteresis_V",
        "min_hold_s",
        "pre_trigger_s",
        "post_trigger_s"
      ],
      "title": "TriggerConfig",
      "type": "object"
    },
    "WaveformRenderer": {
      "description": "Available Phase 2 continuous-waveform rendering backends.",
      "enum": [
        "direct_sparse",
        "recursive_fixed_tau",
        "auto"
      ],
      "title": "WaveformRenderer",
      "type": "string"
    },
    "WaveformSynthesisConfig": {
      "additionalProperties": false,
      "description": "Bounded block rendering and analog clipping configuration.",
      "properties": {
        "renderer": {
          "$ref": "#/$defs/WaveformRenderer",
          "default": "auto"
        },
        "max_samples_per_block": {
          "$ref": "#/$defs/ParameterValue_Annotated_int__Strict_strict_True___"
        },
        "save_analog": {
          "default": true,
          "title": "Save Analog",
          "type": "boolean"
        },
        "analog_clip_min_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        },
        "analog_clip_max_V": {
          "$ref": "#/$defs/ParameterValue_float_"
        }
      },
      "required": [
        "max_samples_per_block",
        "analog_clip_min_V",
        "analog_clip_max_V"
      ],
      "title": "WaveformSynthesisConfig",
      "type": "object"
    }
